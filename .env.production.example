# =============================================================================
# REKLU — production environment (Dokploy)
#
# Paste into Dokploy → Application → Environment, filling in the blanks.
# Dokploy writes this to `.env` next to docker-compose.yml at deploy time.
#
# FORMATTING RULE: never put a comment on the same line as a value.
# Docker Compose's handling of trailing `# ...` in an env file has varied
# between versions, and a value read as "https://reklu.app  # must be https"
# fails validation in a way that is genuinely hard to see. Comments go on their
# own line, always. `pnpm verify:production-config` enforces this.
#
# Do NOT set NODE_ENV. The image sets NODE_ENV=production itself; setting it in
# an env file has previously shipped a development React build to production.
# Do NOT set DATABASE_URL or REDIS_URL. docker-compose.yml derives both from the
# service names and POSTGRES_PASSWORD.
#
# Reklu validates all of this at boot and refuses to start on a configuration it
# cannot honestly serve, reporting every problem at once, by name.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Must be https — secure cookies depend on it.
APP_URL=https://reklu.app
APP_NAME=Reklu

# Admin panel host. Set this and admin lives ONLY there: the main host refuses
# /admin as though it did not exist, and the admin host serves nothing else.
# Point a DNS A record at the same VPS and add the domain in Dokploy.
ADMIN_HOST=admin.reklu.app

# Required whenever ADMIN_HOST is a different host from APP_URL. A cookie set
# for reklu.app is host-only and never reaches admin.reklu.app, so without this
# an administrator would appear signed out. Startup refuses the combination.
SESSION_COOKIE_DOMAIN=.reklu.app
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Secrets — generate each one SEPARATELY. Never reuse one value for two:
#   openssl rand -base64 32
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=
AUTH_SECRET=
# Encrypts stored OAuth tokens and connection credentials at rest. Losing this
# value makes every stored credential undecryptable.
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# AI providers — at least one key is required, or Reklu refuses to boot.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# Embeddings power semantic project memory and file search.
#   openai  requires OPENAI_API_KEY
#   google  requires GOOGLE_GENERATIVE_AI_API_KEY
#   none    deliberate lexical-only retrieval. Choose this if you have no
#           embedding-capable key — Anthropic does not serve embeddings.
#           Recall is weaker, and the UI reports that rather than pretending.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# -----------------------------------------------------------------------------
# Storage
#
# STORAGE_DRIVER=s3 is the durable choice and the one to prefer.
#
# STORAGE_LOCAL_SINGLE_NODE_ACK=true permits the local driver in production. It
# asserts two things Reklu cannot verify from inside a container:
#   1. STORAGE_LOCAL_PATH is a mounted volume (docker-compose.yml mounts one)
#   2. exactly one `web` replica runs
# Scale `web` past one and uploads become invisible to half the requests.
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/.storage
STORAGE_LOCAL_SINGLE_NODE_ACK=true
STORAGE_MAX_UPLOAD_MB=50

# When moving to S3/R2: set STORAGE_DRIVER=s3 and STORAGE_LOCAL_SINGLE_NODE_ACK=false.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# -----------------------------------------------------------------------------
# Build workspace
#
# Build is the only subsystem that executes model-generated code, so it is the
# only one that requires an isolated sandbox. Generated code must never run on
# the Reklu app or worker container.
#
# BUILD_ENABLED=false turns Build off: the UI reports it unavailable and names
# what is missing. This is the correct setting until an isolated sandbox exists.
# To enable it later, set BUILD_ENABLED=true together with either
# SANDBOX_DRIVER=e2b and E2B_API_KEY, or SANDBOX_DRIVER=docker on a Docker host
# that is NOT this one.
# -----------------------------------------------------------------------------
BUILD_ENABLED=false
SANDBOX_DRIVER=local
E2B_API_KEY=

# -----------------------------------------------------------------------------
# Research — blank disables web research; it reports "Not configured".
# Set SEARCH_PROVIDER to brave, tavily or serper together with its key.
# -----------------------------------------------------------------------------
SEARCH_PROVIDER=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
RESEARCH_MAX_SOURCES=32

# -----------------------------------------------------------------------------
# Optional sign-in providers. Register each callback URL with the provider
# using the production origin before enabling.
# -----------------------------------------------------------------------------
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# -----------------------------------------------------------------------------
# Integrations (M6). Redirect URIs already point at the production origin so
# they can be registered with each provider ahead of time.
# -----------------------------------------------------------------------------
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://reklu.app/api/integrations/github/callback
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_OAUTH_REDIRECT_URI=https://reklu.app/api/integrations/vercel/callback
SUPABASE_CLIENT_ID=
SUPABASE_CLIENT_SECRET=
SUPABASE_OAUTH_REDIRECT_URI=https://reklu.app/api/integrations/supabase/callback

# -----------------------------------------------------------------------------
# Billing — blank disables it. STRIPE_SECRET_KEY without STRIPE_WEBHOOK_SECRET
# is rejected at boot, because subscription state would silently drift.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
BILLING_PORTAL_RETURN_URL=https://reklu.app/settings/billing

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
ANALYTICS_ENABLED=false

# -----------------------------------------------------------------------------
# MCP  [feature]
#
# Reklu refuses endpoints that resolve to private or link-local addresses,
# because an endpoint URL is user-supplied and http://169.254.169.254/ reaches
# cloud metadata. A co-located MCP sidecar resolves to exactly such an address,
# so name it here to permit that one host. Comma-separated, matched exactly.
#
# Only set this for services YOU run. Anything named here can be reached by any
# endpoint URL a user types.
# -----------------------------------------------------------------------------
MCP_ALLOWED_HOSTS=

# -----------------------------------------------------------------------------
# Billing — Whop  [feature]
#
# Absent credentials leave billing reporting itself unavailable rather than
# rendering a checkout that cannot take money.
#
# WHOP_API_KEY is required to sell anything, not just to read memberships
# back. Reklu mints a checkout session through the Whop API so the workspace
# id travels in the session metadata; that is the only link between a payment
# and an account that does not rely on matching email addresses. Without the
# key there is no session, so a payment would arrive with nothing identifying
# who made it, and the customer would be charged without being upgraded.
#
# WHOP_WEBHOOK_SECRET is the `ws_...` value shown ONCE when you create the
# webhook. Without it no delivery can be trusted, and Reklu refuses them all:
# an unverified membership event is an unauthenticated instruction to change
# someone's plan.
#
# Prices are set in the admin panel at /admin/billing and pushed to Whop from
# there, so there is no second copy to keep in step. WHOP_COMPANY_ID is the
# `biz_...` company those plans are created under.
#
# Webhook endpoint to register with Whop:
#   https://reklu.app/api/webhooks/whop
# Events to subscribe to:
#   membership.activated, membership.deactivated,
#   membership.cancel_at_period_end_changed, payment.succeeded, payment.failed
# -----------------------------------------------------------------------------
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_WEBHOOK_SECRET=

# Legacy. Plans are defined in the admin panel now and carry their own Whop
# plan id in the database, so these are only read as a fallback for a
# deployment configured before plan management existed. Leave them blank.
WHOP_PLAN_ID_PRO=
WHOP_PLAN_ID_TEAM=
