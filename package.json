{
  "name": "reklu",
  "private": true,
  "version": "0.1.0",
  "description": "Reklu \u2014 One AI Workspace. Every Model. Every Tool. From Idea to Execution.",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @reklu/database db:generate",
    "db:migrate": "pnpm --filter @reklu/database db:migrate",
    "db:push": "pnpm --filter @reklu/database db:push",
    "db:studio": "pnpm --filter @reklu/database db:studio",
    "db:seed": "pnpm --filter @reklu/database db:seed",
    "db:reset": "pnpm --filter @reklu/database db:reset",
    "setup": "bash scripts/setup.sh",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "redis": "redis-server scripts/redis.conf",
    "redis:start": "redis-server scripts/redis.conf --daemonize yes",
    "redis:stop": "redis-cli shutdown nosave || true",
    "worker": "pnpm --filter @reklu/worker dev",
    "verify:auth": "pnpm --filter @reklu/auth exec tsx scripts/verify.mts",
    "verify:projects": "pnpm --filter @reklu/projects exec tsx scripts/verify.mts",
    "verify:queue": "pnpm --filter @reklu/worker exec tsx scripts/verify.mts",
    "verify": "pnpm verify:auth && pnpm verify:projects",
    "verify:build": "pnpm --filter @reklu/build exec tsx scripts/verify.mts",
    "verify:preview": "pnpm --filter @reklu/build exec tsx scripts/verify-preview.mts",
    "verify:production-config": "pnpm --filter @reklu/database exec tsx ../shared/scripts/verify-production-config.mts",
    "verify:repo": "tsx scripts/verify-repo-integrity.mts",
    "verify:e2b": "pnpm --filter @reklu/sandbox exec tsx scripts/verify-e2b.mts",
    "verify:oauth": "pnpm --filter @reklu/auth exec tsx scripts/verify-oauth.mts",
    "verify:skills": "pnpm --filter @reklu/skills exec tsx scripts/verify.mts",
    "verify:mcp": "pnpm --filter @reklu/mcp exec tsx scripts/verify.mts",
    "verify:agents": "pnpm --filter @reklu/agents exec tsx scripts/verify.mts",
    "verify:security": "tsx scripts/verify-security.mts",
    "verify:a11y": "tsx scripts/verify-a11y.mts",
    "verify:perf": "tsx scripts/verify-perf.mts",
    "verify:all": "pnpm verify:repo && pnpm verify:a11y && pnpm verify:perf && pnpm verify:security",
    "admin:promote": "pnpm --filter @reklu/database exec tsx scripts/promote-admin.mts"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.5",
    "axe-core": "^4.13.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.23.12",
    "turbo": "^2.10.10",
    "typescript": "^5.7.3"
  }
}
