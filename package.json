{
  "name": "reklu",
  "private": true,
  "version": "0.1.0",
  "description": "Reklu — One AI Workspace. Every Model. Every Tool. From Idea to Execution.",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @reklu/web test:e2e",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @reklu/database db:generate",
    "db:migrate": "pnpm --filter @reklu/database db:migrate",
    "db:push": "pnpm --filter @reklu/database db:push",
    "db:studio": "pnpm --filter @reklu/database db:studio",
    "db:seed": "pnpm --filter @reklu/database db:seed",
    "db:reset": "pnpm --filter @reklu/database db:reset",
    "setup": "bash scripts/setup.sh",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prettier": "^3.4.2",
    "turbo": "^2.10.10",
    "typescript": "^5.7.3"
  }
}
