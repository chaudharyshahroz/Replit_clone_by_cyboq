# Keep the build context small and — more importantly — keep secrets and host
# state out of the image entirely.

# Secrets. `.env` must never enter an image layer; configuration is injected at
# run time by Dokploy. Deleting it in a later RUN would not help, because the
# layer that added it remains in the image history.
.env
.env.local
.env.*.local

# Host-installed dependencies are the wrong platform and the wrong tree.
node_modules
**/node_modules

# Build output — regenerated inside the image.
.next
**/.next
dist
**/dist
.turbo
**/.turbo
*.tsbuildinfo

# Runtime state that belongs in a volume, never in an image.
.storage
.sandbox
tmp-sandboxes

# Repository and editor metadata.
.git
.github
.vscode
.idea
.claude
.DS_Store

# Test and coverage artefacts.
coverage
playwright-report
test-results
.playwright

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
