node_modules/
.pnpm-store/

.next/
out/
dist/
# Anchored to the repo root on purpose. An unanchored `build/` matches ANY
# directory named build at ANY depth — which silently excluded packages/build,
# apps/web/src/app/(app)/build and apps/web/src/components/build from every
# commit. The Build feature was absent from production for that reason alone.
/build/
.turbo/
*.tsbuildinfo

.env
.env.local
.env.*.local
!.env.example

coverage/
playwright-report/
test-results/
.playwright/

.DS_Store
*.log
npm-debug.log*
pnpm-debug.log*

.vscode/*
!.vscode/extensions.json
.idea/

# Runtime sandbox scratch space — never commit generated user projects
.sandbox/
/tmp-sandboxes/

# Local storage driver bucket (dev only)
.storage/
