# =============================================================================
# REKLU — Environment Configuration
#
# Copy to `.env` and fill in. NEVER commit real secrets.
# Variables marked [required] are validated at startup (packages/shared/src/env).
# Variables marked [feature] gate a capability: absent => the feature reports
# itself as "Not configured" in the UI. It never silently fakes success.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# NODE_ENV is set by the runtime (next dev/build/start, or your
# process manager). Do NOT set it here — forcing it during `next build`
# produces a development React in a production bundle.
APP_URL=http://localhost:3000               # [required] canonical public origin, no trailing slash
APP_NAME=Reklu
LOG_LEVEL=info                              # trace | debug | info | warn | error
PORT=3000

# -----------------------------------------------------------------------------
# Database  (PostgreSQL 15+; pgvector strongly recommended)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres@localhost:5432/reklu   # [required]
DATABASE_POOL_MAX=10
# Set false only if the pgvector extension is unavailable. Semantic retrieval
# then degrades to lexical search — see docs/LOCAL_SETUP.md.
DATABASE_VECTOR_ENABLED=true

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
AUTH_SECRET=                                # [required] openssl rand -base64 32
AUTH_TRUST_HOST=true                        # true when behind a proxy in dev
AUTH_GOOGLE_ID=                             # [feature] Google sign-in
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=                             # [feature] GitHub sign-in (separate app from the GitHub integration below)
AUTH_GITHUB_SECRET=

# -----------------------------------------------------------------------------
# Redis  (cache, rate limiting, BullMQ job queue)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379            # [required]
QUEUE_PREFIX=reklu

# -----------------------------------------------------------------------------
# Storage  (S3-compatible object storage; `local` driver for development only)
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local                        # local | s3
STORAGE_LOCAL_PATH=./.storage               # used when STORAGE_DRIVER=local
# Permits STORAGE_DRIVER=local in production. Asserts that STORAGE_LOCAL_PATH is
# a durable mounted volume AND that exactly one web replica runs. Ignored in dev.
STORAGE_LOCAL_SINGLE_NODE_ACK=false
S3_BUCKET=                                  # [feature] required when STORAGE_DRIVER=s3
S3_REGION=auto
S3_ENDPOINT=                                # e.g. https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=                              # CDN origin for public assets, if any
STORAGE_MAX_UPLOAD_MB=50

# -----------------------------------------------------------------------------
# AI Providers
# At least one must be configured for Chat to function.
# Keys are backend-only and must never reach the browser.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=                          # [feature] Anthropic (Claude)
OPENAI_API_KEY=                             # [feature] OpenAI
GOOGLE_GENERATIVE_AI_API_KEY=               # [feature] Google (Gemini)
XAI_API_KEY=                                # [feature] xAI (Grok)
DEEPSEEK_API_KEY=                           # [feature] DeepSeek

# Embeddings — used for project memory, file retrieval, skills, research knowledge
# openai | google | none. `none` is a deliberate choice to run on lexical
# retrieval only — use it when you have no embedding-capable key.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Image + video generation
IMAGE_PROVIDER=openai                       # [feature] openai | google
VIDEO_PROVIDER=                             # [feature] leave blank to disable video generation

# -----------------------------------------------------------------------------
# Research
# -----------------------------------------------------------------------------
SEARCH_PROVIDER=                            # [feature] brave | tavily | serper — blank disables web research
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
RESEARCH_MAX_SOURCES=32                     # hard ceiling per Deep Research run (cost control)
RESEARCH_FETCH_TIMEOUT_MS=15000
RESEARCH_USER_AGENT="RekluResearchBot/1.0 (+https://reklu.app/bot)"

# -----------------------------------------------------------------------------
# GitHub integration  (user repository connections — NOT the sign-in app above)
# -----------------------------------------------------------------------------
GITHUB_APP_CLIENT_ID=                       # [feature]
GITHUB_APP_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/github/callback

# -----------------------------------------------------------------------------
# Vercel integration  (deployment)
# -----------------------------------------------------------------------------
VERCEL_CLIENT_ID=                           # [feature]
VERCEL_CLIENT_SECRET=
VERCEL_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/vercel/callback

# -----------------------------------------------------------------------------
# Supabase integration  (database provisioning for generated apps)
# -----------------------------------------------------------------------------
SUPABASE_CLIENT_ID=                         # [feature]
SUPABASE_CLIENT_SECRET=
SUPABASE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/supabase/callback

# -----------------------------------------------------------------------------
# Sandbox  (isolated execution of generated code — never runs on the app server)
# -----------------------------------------------------------------------------
# Master switch for the Build workspace — the only subsystem that executes
# model-generated code. Set false to deploy without an isolated sandbox; Build
# then reports itself unavailable instead of running untrusted code unisolated.
BUILD_ENABLED=true
SANDBOX_DRIVER=local                        # local | e2b | docker
SANDBOX_ROOT=./.sandbox                     # local driver working directory
E2B_API_KEY=

# Self-hosted sandbox — run builds on your own Docker daemon instead of E2B.
# Read docs/SELF_HOSTED_SANDBOX.md first: a container shares your host's kernel,
# so the daemon belongs on a different machine from Reklu.
SANDBOX_DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_DOCKER_IMAGE=node:22-bookworm-slim
SANDBOX_DOCKER_NETWORK=reklu-sandbox
# Previews over https on a subdomain, routed by the proxy already in front of
# Reklu. Needs a wildcard DNS record: *.preview.example.com -> this server.
# Preferred over SANDBOX_PREVIEW_HOST: no port range to open, no IP address in
# the URL, and https means the preview can be embedded rather than only linked.
SANDBOX_PREVIEW_DOMAIN=

# --- Launch ---------------------------------------------------------------
# Turns reklu.app into a waitlist: the landing page collects email addresses,
# and the sign in / create account buttons are hidden. It hides them and does
# not disable them — /login and /signup keep working for anyone with the
# address, which is how you reach the admin panel while the front door is shut.
# Addresses land in Admin -> Waitlist. Unset or false is the normal site.
WAITLIST_MODE=false

# --- Publishing -------------------------------------------------------------
# The domain published sites are served under, as <slug>.<domain>. Needs a
# wildcard DNS record: *.sites.example.com -> this server. Keep it separate from
# SANDBOX_PREVIEW_DOMAIN: a preview is private and thrown away within the hour,
# a published site is a public address that has to keep answering.
PUBLISH_DOMAIN=
# This server's public IP, shown to anyone adding their own domain and checked
# against what their DNS actually resolves to. Reklu cannot work it out itself —
# the proxy's public address is not visible from inside the container beside it.
PUBLISH_SERVER_IP=

SANDBOX_PROXY_NETWORK=dokploy-network
SANDBOX_PROXY_CERT_RESOLVER=letsencrypt
# Fallback: the public address of the sandbox machine, with 43000-43200 open.
SANDBOX_PREVIEW_HOST=
# gVisor, if installed on the sandbox host. Setting it without installing fails every build.
SANDBOX_DOCKER_RUNTIME=
# Required to run the daemon on this same machine. Understand the risk first.
SANDBOX_DOCKER_SAME_HOST_ACK=false
# The host's docker group id, so the app (which runs as `node`, not root) can
# read the mounted socket. Find it with: getent group docker | cut -d: -f3
DOCKER_GID=999                                # [feature] required when SANDBOX_DRIVER=e2b
SANDBOX_TIMEOUT_MS=600000
SANDBOX_MAX_MEMORY_MB=2048
SANDBOX_MAX_DISK_MB=1024
SANDBOX_MAX_CONCURRENT=3

# -----------------------------------------------------------------------------
# Billing  (Stripe)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=                          # [feature] billing disabled when blank
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
BILLING_PORTAL_RETURN_URL=http://localhost:3000/settings/billing

# -----------------------------------------------------------------------------
# Encryption  (at-rest encryption for user OAuth tokens and MCP credentials)
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=                             # [required] openssl rand -base64 32 (AES-256-GCM)
ENCRYPTION_KEY_PREVIOUS=                    # optional, set during key rotation

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
SENTRY_DSN=                                 # [feature]
OTEL_EXPORTER_OTLP_ENDPOINT=                # [feature]
ANALYTICS_ENABLED=false
